{
  "name": "museum-html-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "verify:dist": "node tools/check-dist.mjs",
    "check:layers": "node tools/check-layers.mjs",
    "release": "npm run check:layers && npm test && npm run sample:json && npm run build && npm run verify:dist",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/*.test.mts\"",
    "sample:json": "node --experimental-strip-types --no-warnings tools/export-sample.mts",
    "deploy": "sh tools/deploy.sh"
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "@types/three": "^0.181.0"
  }
}
